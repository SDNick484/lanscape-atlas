# Settings for deploy/setup-alpine.sh. Copy to /etc/lanscape-atlas/setup.env on the
# server, fill in the values, then:  chmod 600 /etc/lanscape-atlas/setup.env
# This file holds secrets once filled in. NEVER commit the real one.
#
# Format: KEY=VALUE, one per line. Values are taken literally (no shell expansion).
# Surrounding single or double quotes are stripped, so quote a value that starts or
# ends with a space or quote character.

# --- Required -----------------------------------------------------------------

# Repository to deploy. Use the SSH form for a private repo: the script generates a
# deploy key and tells you where to add it (read-only).
REPO_URL=git@github.com:example/lanscape-atlas.git

# The interface that is bridged onto the LAN to scan (see: ip -br addr).
SCAN_INTERFACE=eth0

# Address the UI listens on: this host's LAN address (e.g. 192.0.2.50). 0.0.0.0 also
# listens on tailscale/docker interfaces; avoid it unless you know you need it.
BIND_HOST=192.0.2.50

# --- ASUS router collector (leave ROUTER_HOST empty to disable it) ------------

ROUTER_HOST=192.0.2.1
ROUTER_USER=admin
ROUTER_PASSWORD=change-me
# ROUTER_USE_SSL=true
# The router allows one admin session at a time. 300 s keeps it from logging you out
# of its web UI too often; lower it once you know how it behaves.
# ASUSROUTER_INTERVAL_S=300

# --- Home Assistant Bluetooth / Find (leave HA_URL empty to disable it) --------

# Home Assistant base URL and a long-lived token from an ADMINISTRATOR account
# (needed for bluetooth/subscribe_advertisements). The token is written only to
# config.toml (mode 0600); this file must stay mode 0600 too.
# If Home Assistant serves TLS, use https:// and the host name on HA's certificate
# (e.g. https://ha.example:8123): an http:// URL to an HTTPS port fails with
# "Server disconnected", and an IP address fails the certificate check when the
# certificate names a host. Plain-HTTP Home Assistant takes http://ADDRESS:8123.
# HA_URL=http://192.0.2.10:8123
# HA_TOKEN=
# HA_VERIFY_TLS=true

# Candidates on the Find page weaker than this many dBm (usually a neighbour's
# devices) are listed only behind "Show N weak". Whole number from -127 to 0;
# unset keeps the default, -80. Raise it (e.g. -70) to hide more, lower it to show more.
# BLE_CANDIDATE_MIN_RSSI=-80

# --- Optional ------------------------------------------------------------------

# Bearer token for /api and /mcp. Unset: kept from the existing config.toml, or a new
# one is generated on first run. Set it to rotate the token.
# API_TOKEN=

# Extra Host headers accepted when no API_TOKEN is in effect, comma separated.
# Use port patterns: 192.0.2.50:*
# ALLOWED_HOSTS=192.0.2.50:*

# BIND_PORT=8720
# Days of raw observations to keep. 14 keeps the database small on a modest disk.
# RETENTION_DAYS=14
# Branch, tag or commit to deploy (also settable with --ref).
# REF=main
